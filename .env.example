# ============================================================================
# PHANTOM AI - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!
# ============================================================================

# =========================
# API Keys (Optional)
# =========================
# OpenAI API key for AI-powered analysis
OPENAI_API_KEY=your_openai_key_here

# Anthropic API key (alternative AI provider)
ANTHROPIC_API_KEY=your_anthropic_key_here

# =========================
# Callback Services
# =========================
# Blind XSS callback server
BLIND_XSS_CALLBACK=https://your-callback-server.com

# Out-of-band testing callback
OOB_CALLBACK_SERVER=https://your-oob-server.com

# Burp Collaborator alternative
COLLABORATOR_URL=https://your-collaborator.com

# =========================
# Notification Services
# =========================
# Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Discord webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Telegram bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# =========================
# Bug Bounty Platforms
# =========================
# HackerOne API token
HACKERONE_API_TOKEN=your_hackerone_token
HACKERONE_USERNAME=your_username

# Bugcrowd API token
BUGCROWD_API_TOKEN=your_bugcrowd_token

# Intigriti API token
INTIGRITI_API_TOKEN=your_intigriti_token

# =========================
# Database (Optional)
# =========================
# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/phantom

# Redis connection
REDIS_URL=redis://localhost:6379/0

# =========================
# Security Settings
# =========================
# Encryption key for sensitive data (auto-generated if not set)
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# JWT secret for API authentication
JWT_SECRET=your_jwt_secret_here

# =========================
# Proxy Settings
# =========================
# HTTP proxy for requests
HTTP_PROXY=http://127.0.0.1:8080

# HTTPS proxy
HTTPS_PROXY=http://127.0.0.1:8080

# Tor SOCKS proxy
TOR_PROXY=socks5://127.0.0.1:9050

# =========================
# Rate Limiting
# =========================
# Default requests per second
DEFAULT_RATE_LIMIT=10

# Burst size
DEFAULT_BURST_SIZE=20

# =========================
# Logging
# =========================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=/var/log/phantom/phantom.log
